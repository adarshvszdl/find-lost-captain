# Copy to .env and fill in. In AWS, set these as task/service environment variables
# (MONGODB_URI and HOST_KEY from Secrets Manager or SSM Parameter Store).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
MONGODB_DB="longlost_captain"
HOST_KEY="<a long password for the first mate's #host page>"
PORT=8080
# Optional tuning
# INTRO_SECONDS=10    # rules countdown players see before each challenge (0 turns it off)
# POLL_MS=500          # how often each server copy re-reads game state from MongoDB
# MONGO_POOL=40        # MongoDB connection pool size per server copy
# LOG_LEVEL=info
